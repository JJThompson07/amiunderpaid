# Playwright e2e: a real recruiter test account, for tests that need to log in
E2E_RECRUITER_EMAIL=""
E2E_RECRUITER_PASSWORD=""

# Vercel Cron auth (name required by Vercel's own convention -- it auto-sends
# this value as `Authorization: Bearer <value>` when invoking a cron job).
# Generate with: openssl rand -hex 32
CRON_SECRET=""
