{
  "name": "amiunderpaid",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "build:dev": "nuxt build --dotenv .env",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "dev:clean": "rm -rf .nuxt node_modules && pnpm install && nuxt dev",
    "postinstall": "nuxt prepare",
    "lint": "pnpm spellcheck && pnpm typecheck && prettier . --check && tsx scripts/structure-lint.ts && tsx scripts/check-standards.ts && eslint --max-warnings 0",
    "lint:fix": "prettier . --write && eslint . --fix --max-warnings 0",
    "lint:i18n": "tsx scripts/check-i18n.ts",
    "check-standards": "tsx scripts/check-standards.ts",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "spellcheck": "cspell lint",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:rules": "npx -y firebase-tools@latest emulators:exec \"vitest run tests/firestore.spec.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nuxtjs/algolia": "^1.11.2",
    "algoliasearch": "^4.27.0",
    "echarts": "^6.1.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^13.10.0",
    "lucide-vue-next": "^0.563.0",
    "nuxt": "^4.5.1",
    "nuxt-gtag": "4.1.0",
    "nuxt-vuefire": "^1.1.2",
    "stripe": "^22.0.1",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "vuefire": "^3.2.3",
    "xlsx": "file:./vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@intlify/utils": "^1.0.1",
    "@nuxt/eslint": "^0.7.6",
    "@nuxtjs/i18n": "^10.2.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/tough-cookie": "^4.0.5",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "cspell": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
