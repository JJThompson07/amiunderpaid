rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is an admin via Custom Claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Global deny-by-default rule
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own profile, admins can manage all
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'activeTerritories', 'basicDiscount'])));
      allow delete: if isAdmin();
    }

    // Platform Settings (read-only for clients)
    match /platform_settings/{document=**} {
      // Any authenticated user can read platform settings (or public if required, keeping it open to authenticated for now)
      // Actually, since pricing is likely public, allow public read or auth read? Let's allow public read for platform_settings.
      allow read: if true;
      allow write: if isAdmin();
    }

    // Additional explicitly allowed collections can be added below as needed
  }
}
