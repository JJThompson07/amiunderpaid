rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is an admin via Custom Claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Global deny-by-default rule
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own profile, admins can manage all
      allow create: if isAdmin() || (isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['role', 'status', 'activeTerritories', 'basicDiscount', 'exclusiveDiscount', 'stripeSubscriptionId'])));
      allow update: if isAdmin() || (isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'activeTerritories', 'basicDiscount', 'exclusiveDiscount', 'stripeSubscriptionId'])));
      allow delete: if isAdmin();
    }

    // Platform Settings (read-only for clients)
    match /platform_settings/{document=**} {
      // Any authenticated user can read platform settings (or public if required, keeping it open to authenticated for now)
      // Actually, since pricing is likely public, allow public read or auth read? Let's allow public read for platform_settings.
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Client-touched collections --- //
    match /leads/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.recruiterId == request.auth.uid);
      allow write: if false; // server-only, via leads/submit.post.ts
    }
    match /territory_claims/{id} {
      allow read: if isAuthenticated();
      allow write: if false; // server-only, via the Stripe webhook
    }
    match /recruiter_contact_settings/{uid} {
      allow read: if true; // rendered on public salary pages
      allow write: if isOwner(uid) || isAdmin();
    }
    match /adzuna_categories/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /job_titles/{id}        { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /user_sessions/{id}     { allow read: if isAdmin();         allow write: if false; }
    match /search_history/{id}    { allow read, write: if false; }    // server-only
    match /mail/{id}              { allow read, write: if false; }    // server-only
    match /job_suggestions/{id}   { allow read: if isAdmin();         allow write: if false; }
    match /uk_job_groups/{id}     { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /usa_job_groups/{id}    { allow read: if isAuthenticated(); allow write: if isAdmin(); }
  }
}
